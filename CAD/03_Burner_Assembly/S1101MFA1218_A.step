HEADER;
FILE_DESCRIPTION(('1/4 INCH SPHERICAL BURNER TUBE ASSEMBLY - NASA GRC / ZIN TECHNOLOGIES','DWG NO S1101MFA1218 REV A','ITEM 1: S1101MFD1219 (1/4 SPHERICAL BURNER TUBE) + ITEM C1: 316L SS POROUS SPHERE'),'2;1');
